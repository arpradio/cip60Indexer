{
  "name": "musicindex",
  "version": "0.1.0-alpha",
  "main": "src/indexer/index.ts",
  "type": "commonjs",
  "scripts": {
    "start": "ts-node --project tsconfig.node.json src/indexer/index.ts",
    "build": "tsc --project tsconfig.node.json",
    "dev": "npm run start",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17", 
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "keywords": [
    "cardano",
    "musicNFT",
    "blockchain",
    "indexer",
    "cip60"
  ],
  "author": "sudoScientist",
  "license": "MIT",
  "description": "A blockchain indexer for CIP-60 compliant Music NFTs on the Cardano network."
